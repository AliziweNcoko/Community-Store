{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "vue": {
      "root": "vue",
      "framework": "vite"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/vue/(.*)",
      "destination": {
        "service": "vue"
      }
    },
    {
      "source": "/vue",
      "destination": {
        "service": "vue"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
